# TranscriptoX Frontend Environment Variables
# =============================================
# Copy this file to .env for local development.
# For production (Vercel), set these as environment variables in the Vercel
# project dashboard — do NOT commit .env to git.

# Backend API base URL (no trailing slash).
#
# Local development:
#   VITE_API_BASE_URL=http://localhost:8000
#
# Production (set this in Vercel dashboard → Settings → Environment Variables):
#   VITE_API_BASE_URL=https://transcriptox-api.onrender.com
#
# IMPORTANT: Vite env vars are baked in at BUILD time.
# After changing this value in Vercel you MUST trigger a new deployment
# (not just a restart) for the change to take effect.
VITE_API_BASE_URL=http://localhost:8000
